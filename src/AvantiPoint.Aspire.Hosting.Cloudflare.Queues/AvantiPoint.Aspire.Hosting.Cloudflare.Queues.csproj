<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>AvantiPoint Aspire Hosting for Cloudflare Queues</Title>
    <Description>Cloudflare Queues hosting integration for Aspire. Provisions a Queue via the Cloudflare API during deploy and, with .RunAsEmulator(), backs it with a local in-memory queue during 'aspire run' so the dev loop needs no cloud credentials. Pairs with AvantiPoint.Aspire.Cloudflare.Queues.</Description>
    <PackageTags>aspire;cloudflare;queues;messaging;hosting;emulator</PackageTags>
    <IsAspireHostingIntegration>true</IsAspireHostingIntegration>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AvantiPoint.Aspire.Hosting.Cloudflare/AvantiPoint.Aspire.Hosting.Cloudflare.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.Queues.Tests" />
  </ItemGroup>

</Project>
