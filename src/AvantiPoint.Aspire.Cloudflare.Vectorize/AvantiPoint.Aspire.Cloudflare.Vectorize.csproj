<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>AvantiPoint Aspire Client for Cloudflare Vectorize</Title>
    <Description>An Aspire client integration for Cloudflare Vectorize. Registers an IVectorizeClient (upsert / query / delete) from the Aspire-injected connection string. The same code runs against an in-memory vector store (dev) and the Vectorize v2 HTTP API (deployed).</Description>
    <PackageTags>aspire;cloudflare;vectorize;vector-database;embeddings;rag;client</PackageTags>
    <IsAspireClientIntegration>true</IsAspireClientIntegration>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.Vectorize.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

</Project>
