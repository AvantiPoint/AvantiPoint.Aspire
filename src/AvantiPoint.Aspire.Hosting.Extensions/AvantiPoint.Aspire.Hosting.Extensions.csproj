<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>AvantiPoint Aspire Hosting Extensions</Title>
    <Description>General-purpose helpers for .NET Aspire app hosts, including deployment-only parameters that are required at publish/deploy time but optional during local development.</Description>
    <PackageTags>aspire;hosting;extensions;parameters;deployment</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Extensions.Tests" />
  </ItemGroup>

</Project>
