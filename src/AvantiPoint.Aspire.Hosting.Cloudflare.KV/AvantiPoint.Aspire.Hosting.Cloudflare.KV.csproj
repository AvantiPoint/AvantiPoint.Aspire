<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>AvantiPoint Aspire Hosting for Cloudflare Workers KV</Title>
    <Description>Cloudflare Workers KV hosting integration for Aspire. Provisions a KV namespace via the Cloudflare API during deploy and, with .RunAsEmulator(), backs it with a local in-memory store during 'aspire run' so the dev loop needs no cloud credentials. Pairs with AvantiPoint.Aspire.Cloudflare.KV.</Description>
    <PackageTags>aspire;cloudflare;kv;workers-kv;key-value;hosting;emulator</PackageTags>
    <IsAspireHostingIntegration>true</IsAspireHostingIntegration>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AvantiPoint.Aspire.Hosting.Cloudflare/AvantiPoint.Aspire.Hosting.Cloudflare.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.KV.Tests" />
  </ItemGroup>

</Project>
