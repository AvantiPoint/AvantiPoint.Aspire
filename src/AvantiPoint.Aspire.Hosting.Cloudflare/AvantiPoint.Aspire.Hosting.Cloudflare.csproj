<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>AvantiPoint Aspire Hosting for Cloudflare</Title>
    <Description>Aspire hosting integration that redirects the publish/deploy pipeline to Cloudflare instead of Azure. Provides a Cloudflare compute environment, API-token validation, Cloudflare Workers and Containers, and custom-domain support.</Description>
    <PackageTags>aspire;cloudflare;hosting;deployment;workers;containers;pages;custom-domains;wrangler</PackageTags>
    <!-- Aspire hosting integration marker -->
    <IsAspireHostingIntegration>true</IsAspireHostingIntegration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Satellite hosting packages and tests consume internal services (token validator, API client). -->
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.R2" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.Pages" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.D1" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.AI" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.Vectorize" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.KV" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.Queues" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.Tests" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.R2.Tests" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.D1.Tests" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.AI.Tests" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.Vectorize.Tests" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.KV.Tests" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.Queues.Tests" />
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.IntegrationTests" />
  </ItemGroup>

</Project>
