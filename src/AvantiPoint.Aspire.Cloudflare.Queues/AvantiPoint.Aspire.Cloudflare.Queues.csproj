<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>AvantiPoint Aspire Client for Cloudflare Queues</Title>
    <Description>An Aspire client integration for Cloudflare Queues. Registers an IQueueClient (send / pull / ack / retry, via the HTTP push + pull-consumer API) from the Aspire-injected connection string. The same code runs against an in-memory queue (dev) and the Queues HTTP API (deployed).</Description>
    <PackageTags>aspire;cloudflare;queues;messaging;client</PackageTags>
    <IsAspireClientIntegration>true</IsAspireClientIntegration>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.Queues.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

</Project>
