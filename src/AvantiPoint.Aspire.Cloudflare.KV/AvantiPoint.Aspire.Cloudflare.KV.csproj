<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>AvantiPoint Aspire Client for Cloudflare Workers KV</Title>
    <Description>An Aspire client integration for Cloudflare Workers KV. Registers an ICloudflareKVClient (get / put / delete / list) from the Aspire-injected connection string. The same code runs against an in-memory store (dev) and the Workers KV HTTP API (deployed).</Description>
    <PackageTags>aspire;cloudflare;kv;workers-kv;key-value;client</PackageTags>
    <IsAspireClientIntegration>true</IsAspireClientIntegration>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvantiPoint.Aspire.Hosting.Cloudflare.KV.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

</Project>
